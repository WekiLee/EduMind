# EduMind 后端环境变量示例
# 复制为 backend/.env 后按需修改。生产环境必须替换所有开发默认密码和密钥。

# ── 运行环境 ──
ENVIRONMENT=development

# ── 数据库 ──
DATABASE_URL=postgresql+asyncpg://edumind:edumind_dev@localhost:5432/edumind
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=edumind_dev
REDIS_URL=redis://localhost:6379/0

# ── 数据库结构变更 ──
# 开发环境默认自动 create_all/兼容旧表；生产环境默认关闭，应使用受控迁移流程。
# AUTO_MIGRATE_ON_STARTUP=true

# ── LLM（配置优先级低于管理员 Web UI）──
# 管理员可在 Web 后台 /admin/config 页面设置 LLM 配置，优先级高于此文件。
# .env 中的配置仅作为首次启动或后台配置为空时的回退值。
LLM_PROVIDER=openai-compatible
LLM_MODEL=deepseek-v4-flash
OPENAI_API_KEY=sk-your-deepseek-api-key-here
OPENAI_BASE_URL=https://api.deepseek.com/v1

# 如需本地模型，取消注释以下配置：
# LLM_PROVIDER=ollama
# LLM_MODEL=qwen2.5:7b
# OLLAMA_BASE_URL=http://localhost:11434

# ── JWT ──
JWT_SECRET=change-this-in-production
JWT_EXPIRATION_HOURS=72

# ── 服务 ──
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DATA_DIR=./data
MAX_UPLOAD_SIZE_MB=50
SUPPORTED_EXTENSIONS=.pdf,.md,.txt,.docx,.pptx

# ── 内置管理员（可选）──
# 未配置时跳过内置管理员创建，首位自助注册用户自动成为管理员。
# DEFAULT_ADMIN_PASSWORD=请使用强随机密码

# ── 语音 ──
# Whisper 模型大小: tiny / base / small / medium / large-v3
WHISPER_MODEL_SIZE=base
# TTS 引擎: edge-tts（默认）| kokoro（ONNX，需 pip install kokoro）
TTS_PROVIDER=edge-tts

# ── 搜索编排 ──
# 搜索 Provider: duckduckgo（免费，无需 Key）| searxng（自建实例）| none（关闭搜索）
SEARCH_PROVIDER=duckduckgo
# SearXNG 实例地址（仅 searxng provider 需要）
# SEARCH_API_URL=http://localhost:8888
# SEARCH_MAX_RESULTS=5

# ── 向量嵌入（pgvector 语义搜索）──
# Provider: local（本地 sentence-transformers）| litellm（远程 API）
EMBEDDING_PROVIDER=local
# local 模型: all-MiniLM-L6-v2（默认，384维）| all-mpnet-base-v2（768维）
# litellm 模型: text-embedding-ada-002（1536维）| openai/text-embedding-3-small
EMBEDDING_MODEL=all-MiniLM-L6-v2
# 向量维度（必须与所选模型匹配）: 384 / 768 / 1536
EMBEDDING_DIM=384

# ── MCP 工具调用 ──
# 启用后 LLM 教学时可通过 MCP 协议调用外部工具
MCP_ENABLED=false
# MCP Server 配置（JSON 格式）
# MCP_SERVERS=[{"name":"web-search","command":"npx","args":["-y","@mcp-server/web-search"]}]

# ── 上下文管理 ──
CONTEXT_MAX_TOKENS=4096
CONTEXT_RECENT_MESSAGES=6
CONTEXT_SUMMARY_THRESHOLD=12
CACHE_TTL_SECONDS=3600
SESSION_CACHE_TTL=7200
